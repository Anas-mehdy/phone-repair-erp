generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  STAFF
}

enum RepairStatus {
  PENDING
  DIAGNOSING
  REPAIRING
  WAITING_PARTS
  DONE
  DELIVERED
  CANCELLED
}

enum InventoryMovementType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
  SALE
  REPAIR_USAGE
  RETURN
}

enum InvoiceType {
  REPAIR
  SALE
  MANUAL
}

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  VOID
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  OTHER
}

enum SaleStatus {
  DRAFT
  COMPLETED
  CANCELLED
  REFUNDED
}

model Shop {
  id                    String                @id @default(uuid()) @db.Uuid
  name                  String
  phone                 String?
  address               String?
  currency              String                @default("SAR")
  taxNumber             String?
  taxRate               Decimal               @default(15) @db.Decimal(5, 2)
  terms                 String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  deletedAt             DateTime?
  version               Int                   @default(1)

  users                 User[]
  customers             Customer[]
  suppliers             Supplier[]
  repairOrders          RepairOrder[]
  repairStatusHistories RepairStatusHistory[]
  inventoryItems        InventoryItem[]
  inventoryMovements    InventoryMovement[]
  sales                 Sale[]
  saleItems             SaleItem[]
  invoices              Invoice[]
  payments              Payment[]
  whatsappTemplates     WhatsAppTemplate[]

  @@index([updatedAt])
  @@index([deletedAt])
}

model User {
  id                String    @id @default(uuid()) @db.Uuid
  shopId            String    @db.Uuid
  email             String    @unique
  name              String
  passwordHash      String?
  role              UserRole  @default(OWNER)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?
  version           Int       @default(1)

  shop              Shop      @relation(fields: [shopId], references: [id])

  @@index([shopId, updatedAt])
  @@index([shopId, deletedAt])
}

model Customer {
  id                String        @id @default(uuid()) @db.Uuid
  shopId            String        @db.Uuid
  clientGeneratedId String?
  name              String
  phone             String?
  phoneNormalized   String?
  email             String?
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?
  version           Int           @default(1)

  shop              Shop          @relation(fields: [shopId], references: [id])
  repairOrders      RepairOrder[]
  sales             Sale[]
  invoices          Invoice[]

  @@unique([shopId, clientGeneratedId])
  @@index([shopId, name])
  @@index([shopId, phone])
  @@index([shopId, phoneNormalized])
  @@index([shopId, updatedAt])
  @@index([shopId, deletedAt])
}

model Supplier {
  id                String        @id @default(uuid()) @db.Uuid
  shopId            String        @db.Uuid
  name              String
  phone             String?
  phoneNormalized   String?
  address           String?
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?
  version           Int           @default(1)

  shop              Shop          @relation(fields: [shopId], references: [id])
  repairOrders      RepairOrder[]

  @@index([shopId, name])
  @@index([shopId, phone])
  @@index([shopId, phoneNormalized])
  @@index([shopId, updatedAt])
  @@index([shopId, deletedAt])
}

model RepairOrder {
  id                 String                @id @default(uuid()) @db.Uuid
  shopId             String                @db.Uuid
  customerId         String?               @db.Uuid
  supplierId         String?               @db.Uuid
  createdByUserId    String?               @db.Uuid
  clientGeneratedId  String?
  ticketNumber       String
  status             RepairStatus          @default(PENDING)
  deviceBrand        String?
  deviceModel        String?
  deviceSerial       String?
  reportedIssue      String
  diagnosis          String?
  resolutionNotes    String?
  estimatedTotal     Decimal?              @db.Decimal(12, 2)
  finalTotal         Decimal?              @db.Decimal(12, 2)
  supplierName       String?
  partName           String?
  partCost           Decimal?              @db.Decimal(12, 2)
  deductPartCost     Boolean               @default(true)
  supplierNotes      String?
  dueAt              DateTime?
  completedAt        DateTime?
  deliveredAt        DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  deletedAt          DateTime?
  version            Int                   @default(1)

  shop               Shop                  @relation(fields: [shopId], references: [id])
  customer           Customer?             @relation(fields: [customerId], references: [id])
  supplier           Supplier?             @relation(fields: [supplierId], references: [id])
  statusHistory      RepairStatusHistory[]
  inventoryMovements InventoryMovement[]
  invoices           Invoice[]

  @@unique([shopId, ticketNumber])
  @@unique([shopId, clientGeneratedId])
  @@index([shopId, status])
  @@index([shopId, customerId])
  @@index([shopId, supplierId])
  @@index([shopId, createdByUserId])
  @@index([shopId, updatedAt])
  @@index([shopId, deletedAt])
}

model RepairStatusHistory {
  id                String        @id @default(uuid()) @db.Uuid
  shopId            String        @db.Uuid
  repairOrderId     String        @db.Uuid
  createdByUserId   String?       @db.Uuid
  clientGeneratedId String?
  fromStatus        RepairStatus?
  toStatus          RepairStatus
  note              String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?
  version           Int           @default(1)

  shop              Shop          @relation(fields: [shopId], references: [id])
  repairOrder       RepairOrder   @relation(fields: [repairOrderId], references: [id])

  @@unique([shopId, clientGeneratedId])
  @@index([shopId, repairOrderId, createdAt])
  @@index([shopId, createdByUserId])
  @@index([shopId, updatedAt])
  @@index([shopId, deletedAt])
}

model InventoryItem {
  id                String              @id @default(uuid()) @db.Uuid
  shopId            String              @db.Uuid
  clientGeneratedId String?
  sku               String?
  category          String?
  name              String
  description       String?
  unitCost          Decimal?            @db.Decimal(12, 2)
  unitPrice         Decimal             @db.Decimal(12, 2)
  quantity          Int                 @default(0)
  reorderLevel      Int                 @default(0)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  deletedAt         DateTime?
  version           Int                 @default(1)

  shop              Shop                @relation(fields: [shopId], references: [id])
  movements         InventoryMovement[]
  saleItems         SaleItem[]

  @@index([shopId, sku])
  @@unique([shopId, clientGeneratedId])
  @@index([shopId, name])
  @@index([shopId, updatedAt])
  @@index([shopId, deletedAt])
}

model InventoryMovement {
  id                String                @id @default(uuid()) @db.Uuid
  shopId            String                @db.Uuid
  inventoryItemId   String                @db.Uuid
  repairOrderId     String?               @db.Uuid
  saleId            String?               @db.Uuid
  saleItemId        String?               @db.Uuid
  createdByUserId   String?               @db.Uuid
  clientGeneratedId String?
  type              InventoryMovementType
  quantityChange    Int
  quantityAfter     Int?
  unitCostSnapshot  Decimal?              @db.Decimal(12, 2)
  note              String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  deletedAt         DateTime?
  version           Int                   @default(1)

  shop              Shop                  @relation(fields: [shopId], references: [id])
  inventoryItem     InventoryItem         @relation(fields: [inventoryItemId], references: [id])
  repairOrder       RepairOrder?          @relation(fields: [repairOrderId], references: [id])
  sale              Sale?                 @relation(fields: [saleId], references: [id])
  saleItem          SaleItem?             @relation(fields: [saleItemId], references: [id])

  @@unique([shopId, clientGeneratedId])
  @@index([shopId, inventoryItemId, createdAt])
  @@index([shopId, repairOrderId])
  @@index([shopId, saleId])
  @@index([shopId, saleItemId])
  @@index([shopId, createdByUserId])
  @@index([shopId, updatedAt])
  @@index([shopId, deletedAt])
}

model Sale {
  id                 String     @id @default(uuid()) @db.Uuid
  shopId             String     @db.Uuid
  customerId         String?    @db.Uuid
  createdByUserId    String?    @db.Uuid
  clientGeneratedId  String?
  receiptNumber      String?
  status             SaleStatus @default(COMPLETED)
  subtotal           Decimal    @db.Decimal(12, 2)
  discountTotal      Decimal    @default(0) @db.Decimal(12, 2)
  taxTotal           Decimal    @default(0) @db.Decimal(12, 2)
  total              Decimal    @db.Decimal(12, 2)
  soldAt             DateTime   @default(now())
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  deletedAt          DateTime?
  version            Int        @default(1)

  shop               Shop       @relation(fields: [shopId], references: [id])
  customer           Customer?  @relation(fields: [customerId], references: [id])
  items              SaleItem[]
  inventoryMovements InventoryMovement[]
  invoices           Invoice[]

  @@unique([shopId, receiptNumber])
  @@unique([shopId, clientGeneratedId])
  @@index([shopId, soldAt])
  @@index([shopId, customerId])
  @@index([shopId, createdByUserId])
  @@index([shopId, updatedAt])
  @@index([shopId, deletedAt])
}

model SaleItem {
  id                String              @id @default(uuid()) @db.Uuid
  shopId            String              @db.Uuid
  saleId            String              @db.Uuid
  inventoryItemId   String?             @db.Uuid
  clientGeneratedId String?
  description       String
  quantity          Int
  unitPriceSnapshot Decimal             @db.Decimal(12, 2)
  discountTotal     Decimal             @default(0) @db.Decimal(12, 2)
  lineTotal         Decimal             @db.Decimal(12, 2)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  deletedAt         DateTime?
  version           Int                 @default(1)

  shop              Shop                @relation(fields: [shopId], references: [id])
  sale              Sale                @relation(fields: [saleId], references: [id])
  inventoryItem     InventoryItem?      @relation(fields: [inventoryItemId], references: [id])
  inventoryMovements InventoryMovement[]

  @@unique([shopId, clientGeneratedId])
  @@index([shopId, saleId])
  @@index([shopId, inventoryItemId])
  @@index([shopId, updatedAt])
  @@index([shopId, deletedAt])
}

model Invoice {
  id                String        @id @default(uuid()) @db.Uuid
  shopId            String        @db.Uuid
  customerId        String?       @db.Uuid
  repairOrderId     String?       @db.Uuid
  saleId            String?       @db.Uuid
  createdByUserId   String?       @db.Uuid
  clientGeneratedId String?
  invoiceNumber     String
  type              InvoiceType
  status            InvoiceStatus @default(UNPAID)
  subtotal          Decimal       @db.Decimal(12, 2)
  discountTotal     Decimal       @default(0) @db.Decimal(12, 2)
  taxTotal          Decimal       @default(0) @db.Decimal(12, 2)
  total             Decimal       @db.Decimal(12, 2)
  amountPaid        Decimal       @default(0) @db.Decimal(12, 2)
  balanceDue        Decimal       @default(0) @db.Decimal(12, 2)
  issuedAt          DateTime      @default(now())
  dueAt             DateTime?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?
  version           Int           @default(1)

  shop              Shop          @relation(fields: [shopId], references: [id])
  customer          Customer?     @relation(fields: [customerId], references: [id])
  repairOrder       RepairOrder?  @relation(fields: [repairOrderId], references: [id])
  sale              Sale?         @relation(fields: [saleId], references: [id])
  payments          Payment[]

  @@unique([shopId, invoiceNumber])
  @@unique([shopId, clientGeneratedId])
  @@index([shopId, status])
  @@index([shopId, type])
  @@index([shopId, customerId])
  @@index([shopId, repairOrderId])
  @@index([shopId, saleId])
  @@index([shopId, createdByUserId])
  @@index([shopId, issuedAt])
  @@index([shopId, updatedAt])
  @@index([shopId, deletedAt])
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  shopId            String        @db.Uuid
  invoiceId         String        @db.Uuid
  createdByUserId   String?       @db.Uuid
  clientGeneratedId String?
  method            PaymentMethod
  amount            Decimal       @db.Decimal(12, 2)
  reference         String?
  note              String?
  paidAt            DateTime      @default(now())
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?
  version           Int           @default(1)

  shop              Shop          @relation(fields: [shopId], references: [id])
  invoice           Invoice       @relation(fields: [invoiceId], references: [id])

  @@unique([shopId, clientGeneratedId])
  @@index([shopId, invoiceId])
  @@index([shopId, createdByUserId])
  @@index([shopId, paidAt])
  @@index([shopId, updatedAt])
  @@index([shopId, deletedAt])
}

model WhatsAppTemplate {
  id                String    @id @default(uuid()) @db.Uuid
  shopId            String    @db.Uuid
  createdByUserId   String?   @db.Uuid
  title             String
  templateText      String    @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?
  version           Int       @default(1)

  shop              Shop      @relation(fields: [shopId], references: [id])

  @@index([shopId, updatedAt])
  @@index([shopId, deletedAt])
  @@index([shopId, createdByUserId])
}

