generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------
// ENUMS
// ---------------------------------------------------------

// Legacy Role enum retained for backward compatibility during Phase 1 migration
enum UserRole {
  OWNER
  STAFF
}

// Modern Multi-User Membership Roles
enum MembershipRole {
  OWNER        // مالك المتجر: تحكم كامل بالمتجر والموظفين والاشتراكات
  ADMIN        // مدير الفرع: إدارة العمليات والمخزون والفريق (دون الفوترة وحذف المتجر)
  TECHNICIAN   // فني صيانة: إنشاء وتعديل تذاكر الصيانة وقطع الغيار
  VIEWER       // مشاهد: قراءة التقارير والتذاكر دون تعديل
}

// Membership Status Lifecycle
enum MembershipStatus {
  ACTIVE       // عضو نشط يحق له الوصول
  SUSPENDED    // عضو مجمد مؤقتاً بواسطة المالك
  REMOVED      // عضو ملغى من المتجر مع الحفاظ على سجل عملياته
}

// Invitation Lifecycle
enum InvitationStatus {
  PENDING      // دعوة قيد الانتظار لم تُقبل بعد
  ACCEPTED     // دعوة تم قبولها وانضم الموظف
  REVOKED      // دعوة تم إلغاؤها من قبل الإدارة
  EXPIRED      // دعوة انتهت صلاحيتها الزمنية
}

enum RepairStatus {
  PENDING
  DIAGNOSING
  REPAIRING
  WAITING_PARTS
  DONE
  DELIVERED
  CANCELLED
}

enum InventoryMovementType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
  SALE
  REPAIR_USAGE
  RETURN
}

enum InvoiceType {
  REPAIR
  SALE
  MANUAL
}

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  VOID
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  OTHER
}

enum SaleStatus {
  DRAFT
  COMPLETED
  CANCELLED
  REFUNDED
}

// ---------------------------------------------------------
// TENANT / BUSINESS MODEL
// ---------------------------------------------------------

model Shop {
  id                    String                @id @default(uuid()) @db.Uuid
  name                  String
  phone                 String?
  address               String?
  currency              String                @default("SAR")
  taxNumber             String?
  taxRate               Decimal               @default(15) @db.Decimal(5, 2)
  terms                 String?
  maxSeats              Int                   @default(5) // حد المقاعد المسموح بها وفق خطة الاشتراك
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  deletedAt             DateTime?
  version               Int                   @default(1)

  // Relationships
  memberships           Membership[]
  invitations           ShopInvitation[]
  users                 User[]                // Legacy direct relation (Phase 1 compatibility)
  customers             Customer[]
  suppliers             Supplier[]
  repairOrders          RepairOrder[]
  repairStatusHistories RepairStatusHistory[]
  inventoryItems        InventoryItem[]
  inventoryMovements    InventoryMovement[]
  sales                 Sale[]
  saleItems             SaleItem[]
  invoices              Invoice[]
  payments              Payment[]
  whatsappTemplates     WhatsAppTemplate[]

  @@index([updatedAt])
  @@index([deletedAt])
}

// ---------------------------------------------------------
// USER IDENTITY & MEMBERSHIP
// ---------------------------------------------------------

model User {
  id                String            @id @default(uuid()) @db.Uuid
  email             String            @unique
  name              String
  phone             String?
  passwordHash      String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?
  version           Int               @default(1)

  // Modern Multi-Tenancy Relations
  memberships       Membership[]
  sentInvitations   ShopInvitation[]  @relation("InvitedByUser")

  // Legacy Fields (Retained for Phase 1 backward compatibility / safe migration)
  // [DEPRECATED]: These will be removed in a future migration after complete transition to Membership
  shopId            String            @db.Uuid
  role              UserRole          @default(OWNER)
  shop              Shop              @relation(fields: [shopId], references: [id])

  @@index([email])
  @@index([shopId, updatedAt])
  @@index([shopId, deletedAt])
}

model Membership {
  id                String            @id @default(uuid()) @db.Uuid
  shopId            String            @db.Uuid
  userId            String            @db.Uuid
  role              MembershipRole    @default(TECHNICIAN)
  status            MembershipStatus  @default(ACTIVE)
  joinedAt          DateTime          @default(now())
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?

  shop              Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shopId, userId])
  @@index([shopId, status])
  @@index([userId, status])
  @@index([shopId, role])
  @@index([shopId, updatedAt])
}

model ShopInvitation {
  id                String            @id @default(uuid()) @db.Uuid
  shopId            String            @db.Uuid
  email             String
  role              MembershipRole    @default(TECHNICIAN)
  tokenHash         String            @unique // SHA-256 hash of the 32-byte cryptographically secure token
  status            InvitationStatus  @default(PENDING)
  invitedByUserId   String?           @db.Uuid
  expiresAt         DateTime
  acceptedAt        DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?

  shop              Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  invitedBy         User?             @relation("InvitedByUser", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@index([shopId, status])
  @@index([email, status])
  @@index([tokenHash])
  @@index([expiresAt])
}

// ---------------------------------------------------------
// BUSINESS DATA MODELS (Fully Multi-Tenant via shopId)
// ---------------------------------------------------------

model Customer {
  id                String        @id @default(uuid()) @db.Uuid
  shopId            String        @db.Uuid
  clientGeneratedId String?
  name              String
  phone             String?
  phoneNormalized   String?
  email             String?
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?
  version           Int           @default(1)

  shop              Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  repairOrders      RepairOrder[]
  sales             Sale[]
  invoices          Invoice[]

  @@unique([shopId, clientGeneratedId])
  @@index([shopId, name])
  @@index([shopId, phone])
  @@index([shopId, phoneNormalized])
  @@index([shopId, updatedAt])
  @@index([shopId, deletedAt])
}

model Supplier {
  id                String        @id @default(uuid()) @db.Uuid
  shopId            String        @db.Uuid
  name              String
  phone             String?
  phoneNormalized   String?
  address           String?
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?
  version           Int           @default(1)

  shop              Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  repairOrders      RepairOrder[]

  @@index([shopId, name])
  @@index([shopId, phone])
  @@index([shopId, phoneNormalized])
  @@index([shopId, updatedAt])
  @@index([shopId, deletedAt])
}

model RepairOrder {
  id                 String                @id @default(uuid()) @db.Uuid
  shopId             String                @db.Uuid
  customerId         String?               @db.Uuid
  supplierId         String?               @db.Uuid
  createdByUserId    String?               @db.Uuid
  assignedToUserId   String?               @db.Uuid // الفني المسؤول عن تنفيذ طلب الصيانة
  updatedByUserId    String?               @db.Uuid // آخر مستخدم أجرى تعديلاً على الطلب
  clientGeneratedId  String?
  ticketNumber       String
  status             RepairStatus          @default(PENDING)
  deviceBrand        String?
  deviceModel        String?
  deviceSerial       String?
  reportedIssue      String
  diagnosis          String?
  resolutionNotes    String?
  estimatedTotal     Decimal?              @db.Decimal(12, 2)
  finalTotal         Decimal?              @db.Decimal(12, 2)
  supplierName       String?
  partName           String?
  partCost           Decimal?              @db.Decimal(12, 2)
  deductPartCost     Boolean               @default(true)
  supplierNotes      String?
  dueAt              DateTime?
  completedAt        DateTime?
  deliveredAt        DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  deletedAt          DateTime?
  version            Int                   @default(1)

  shop               Shop                  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer           Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  supplier           Supplier?             @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  statusHistory      RepairStatusHistory[]
  inventoryMovements InventoryMovement[]
  invoices           Invoice[]

  @@unique([shopId, ticketNumber])
  @@unique([shopId, clientGeneratedId])
  @@index([shopId, status])
  @@index([shopId, customerId])
  @@index([shopId, supplierId])
  @@index([shopId, createdByUserId])
  @@index([shopId, assignedToUserId])
  @@index([shopId, updatedByUserId])
  @@index([shopId, updatedAt])
  @@index([shopId, deletedAt])
}

model RepairStatusHistory {
  id                String        @id @default(uuid()) @db.Uuid
  shopId            String        @db.Uuid
  repairOrderId     String        @db.Uuid
  createdByUserId   String?       @db.Uuid
  clientGeneratedId String?
  fromStatus        RepairStatus?
  toStatus          RepairStatus
  note              String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?
  version           Int           @default(1)

  shop              Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  repairOrder       RepairOrder   @relation(fields: [repairOrderId], references: [id], onDelete: Cascade)

  @@unique([shopId, clientGeneratedId])
  @@index([shopId, repairOrderId, createdAt])
  @@index([shopId, createdByUserId])
  @@index([shopId, updatedAt])
  @@index([shopId, deletedAt])
}

model InventoryItem {
  id                String              @id @default(uuid()) @db.Uuid
  shopId            String              @db.Uuid
  clientGeneratedId String?
  sku               String?
  category          String?
  name              String
  description       String?
  unitCost          Decimal?            @db.Decimal(12, 2)
  unitPrice         Decimal             @db.Decimal(12, 2)
  quantity          Int                 @default(0)
  reorderLevel      Int                 @default(0)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  deletedAt         DateTime?
  version           Int                 @default(1)

  shop              Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  movements         InventoryMovement[]
  saleItems         SaleItem[]

  @@index([shopId, sku])
  @@unique([shopId, clientGeneratedId])
  @@index([shopId, name])
  @@index([shopId, updatedAt])
  @@index([shopId, deletedAt])
}

model InventoryMovement {
  id                String                @id @default(uuid()) @db.Uuid
  shopId            String                @db.Uuid
  inventoryItemId   String                @db.Uuid
  repairOrderId     String?               @db.Uuid
  saleId            String?               @db.Uuid
  saleItemId        String?               @db.Uuid
  createdByUserId   String?               @db.Uuid
  clientGeneratedId String?
  type              InventoryMovementType
  quantityChange    Int
  quantityAfter     Int?
  unitCostSnapshot  Decimal?              @db.Decimal(12, 2)
  note              String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  deletedAt         DateTime?
  version           Int                   @default(1)

  shop              Shop                  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  inventoryItem     InventoryItem         @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  repairOrder       RepairOrder?          @relation(fields: [repairOrderId], references: [id], onDelete: SetNull)
  sale              Sale?                 @relation(fields: [saleId], references: [id], onDelete: SetNull)
  saleItem          SaleItem?             @relation(fields: [saleItemId], references: [id], onDelete: SetNull)

  @@unique([shopId, clientGeneratedId])
  @@index([shopId, inventoryItemId, createdAt])
  @@index([shopId, repairOrderId])
  @@index([shopId, saleId])
  @@index([shopId, saleItemId])
  @@index([shopId, createdByUserId])
  @@index([shopId, updatedAt])
  @@index([shopId, deletedAt])
}

model Sale {
  id                 String     @id @default(uuid()) @db.Uuid
  shopId             String     @db.Uuid
  customerId         String?    @db.Uuid
  createdByUserId    String?    @db.Uuid
  clientGeneratedId  String?
  receiptNumber      String?
  status             SaleStatus @default(COMPLETED)
  subtotal           Decimal    @db.Decimal(12, 2)
  discountTotal      Decimal    @default(0) @db.Decimal(12, 2)
  taxTotal           Decimal    @default(0) @db.Decimal(12, 2)
  total              Decimal    @db.Decimal(12, 2)
  soldAt             DateTime   @default(now())
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  deletedAt          DateTime?
  version            Int        @default(1)

  shop               Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer           Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items              SaleItem[]
  inventoryMovements InventoryMovement[]
  invoices           Invoice[]

  @@unique([shopId, receiptNumber])
  @@unique([shopId, clientGeneratedId])
  @@index([shopId, soldAt])
  @@index([shopId, customerId])
  @@index([shopId, createdByUserId])
  @@index([shopId, updatedAt])
  @@index([shopId, deletedAt])
}

model SaleItem {
  id                String              @id @default(uuid()) @db.Uuid
  shopId            String              @db.Uuid
  saleId            String              @db.Uuid
  inventoryItemId   String?             @db.Uuid
  clientGeneratedId String?
  description       String
  quantity          Int
  unitPriceSnapshot Decimal             @db.Decimal(12, 2)
  discountTotal     Decimal             @default(0) @db.Decimal(12, 2)
  lineTotal         Decimal             @db.Decimal(12, 2)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  deletedAt         DateTime?
  version           Int                 @default(1)

  shop              Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  sale              Sale                @relation(fields: [saleId], references: [id], onDelete: Cascade)
  inventoryItem     InventoryItem?      @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  inventoryMovements InventoryMovement[]

  @@unique([shopId, clientGeneratedId])
  @@index([shopId, saleId])
  @@index([shopId, inventoryItemId])
  @@index([shopId, updatedAt])
  @@index([shopId, deletedAt])
}

model Invoice {
  id                String        @id @default(uuid()) @db.Uuid
  shopId            String        @db.Uuid
  customerId        String?       @db.Uuid
  repairOrderId     String?       @db.Uuid
  saleId            String?       @db.Uuid
  createdByUserId   String?       @db.Uuid
  clientGeneratedId String?
  invoiceNumber     String
  type              InvoiceType
  status            InvoiceStatus @default(UNPAID)
  subtotal          Decimal       @db.Decimal(12, 2)
  discountTotal     Decimal       @default(0) @db.Decimal(12, 2)
  taxTotal          Decimal       @default(0) @db.Decimal(12, 2)
  total             Decimal       @db.Decimal(12, 2)
  amountPaid        Decimal       @default(0) @db.Decimal(12, 2)
  balanceDue        Decimal       @default(0) @db.Decimal(12, 2)
  issuedAt          DateTime      @default(now())
  dueAt             DateTime?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?
  version           Int           @default(1)

  shop              Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer          Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  repairOrder       RepairOrder?  @relation(fields: [repairOrderId], references: [id], onDelete: SetNull)
  sale              Sale?         @relation(fields: [saleId], references: [id], onDelete: SetNull)
  payments          Payment[]

  @@unique([shopId, invoiceNumber])
  @@unique([shopId, clientGeneratedId])
  @@index([shopId, status])
  @@index([shopId, type])
  @@index([shopId, customerId])
  @@index([shopId, repairOrderId])
  @@index([shopId, saleId])
  @@index([shopId, createdByUserId])
  @@index([shopId, issuedAt])
  @@index([shopId, updatedAt])
  @@index([shopId, deletedAt])
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  shopId            String        @db.Uuid
  invoiceId         String        @db.Uuid
  createdByUserId   String?       @db.Uuid
  clientGeneratedId String?
  method            PaymentMethod
  amount            Decimal       @db.Decimal(12, 2)
  reference         String?
  note              String?
  paidAt            DateTime      @default(now())
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?
  version           Int           @default(1)

  shop              Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  invoice           Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([shopId, clientGeneratedId])
  @@index([shopId, invoiceId])
  @@index([shopId, createdByUserId])
  @@index([shopId, paidAt])
  @@index([shopId, updatedAt])
  @@index([shopId, deletedAt])
}

model WhatsAppTemplate {
  id                String    @id @default(uuid()) @db.Uuid
  shopId            String    @db.Uuid
  createdByUserId   String?   @db.Uuid
  title             String
  templateText      String    @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?
  version           Int       @default(1)

  shop              Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, updatedAt])
  @@index([shopId, deletedAt])
  @@index([shopId, createdByUserId])
}
